# Copy to .env and fill in. .env is read by minibot/config.py at startup.
# Never commit real keys.

# ---- AI provider -------------------------------------------------
# ollama | gemini | openai
# ollama = fully local: Whisper (mlx-whisper) hears you, an Ollama model
# answers. No API key, and nothing you say leaves this machine. gemini/openai
# are kept switchable (§24).
AI_PROVIDER=ollama

# Needs the Ollama app running and the model pulled:
#   ollama pull qwen3-vl:30b-a3b-instruct
# Pick a model with both "vision" and "tools" in `ollama show <model>`.
# qwen3-vl:30b-a3b-instruct is a mixture-of-experts with ~3B active, so it
# answers in a couple of seconds; qwen3-vl:8b-instruct fits smaller Macs.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:30b-a3b-instruct
# If another app uses the same model through Ollama, give both the same
# context size, or Ollama reloads the model every time control passes between them.
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model loaded between turns. Reloading after an
# idle spell costs several seconds on the next reply.
OLLAMA_KEEP_ALIVE=24h
# Local speech-to-text (Apple Silicon). Downloaded on first run, ~1.6 GB.
STT_MODEL=mlx-community/whisper-large-v3-turbo
# Blank = detect the language per turn. Pin it if short clips misfire.
STT_LANGUAGE=
# The languages you speak, comma-separated. Anything Whisper hears as another
# language (a video playing, background noise) is ignored. Blank = accept all.
STT_LANGUAGES=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-robotics-er-2-streaming-preview

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2

# ---- Speech (ElevenLabs cloned voice) ----------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# ---- Robot transport ---------------------------------------------
# Your robot's address on the LAN. It prints this to the serial monitor on
# boot; there is nothing special about the example below.
ESP32_BASE_URL=http://192.168.1.79
ESP32_TIMEOUT=8
ESP32_RETRIES=2

# ---- Audio / turn taking -----------------------------------------
# mac = this computer's own microphone (default). Lower latency, endpoints
# locally, and needs a one-time mic permission grant in System Settings >
# Privacy & Security > Microphone (grant it interactively in a real terminal —
# it cannot be approved through an automated session).
# bot = the robot's own MAX4466, for when it should hear the room itself.
AUDIO_INPUT=mac
# Which of this computer's microphones, by (part of) its name. Blank = the
# system default. Falls back to the default, with a warning, when unplugged.
MIC_DEVICE=EarPods
# Where the robot's voice plays: bot = the robot's own speaker, mac = this
# computer's. With both mic and voice on the Mac the robot body is optional —
# if it is unreachable the bot still talks, just without face, head or camera.
AUDIO_OUTPUT=bot
# Which output, by (part of) its name. Blank = the system default output.
SPEAKER_DEVICE=MacBook Pro Speakers
SILENCE_MS=1000
MAX_TURN_MS=12000
LEAD_MS=1500
# ROBOT_VOLUME=10        # 0-15, 10 = unity. Unset leaves the robot's own setting.

# ---- Servo limits (must match the #defines in ai_mini_bot.ino) ---
SERVO_MIN_PAN=15
SERVO_MAX_PAN=165
SERVO_MIN_TILT=30
SERVO_MAX_TILT=150

# ---- Camera policy (Gemini Live accepts at most 1 FPS) -----------
CAMERA_IDLE_FPS=0
CAMERA_CONVERSATION_FPS=0.2
CAMERA_VISUAL_QUERY_FPS=1.0
CAMERA_TRACKING_FPS=0.1

# ---- Memory -------------------------------------------------------
MEMORY_DB_PATH=minibot_memory.db
EMBEDDING_MODEL=minishlab/potion-base-8M
MEMORY_RETRIEVAL_LIMIT=6
MEMORY_MIN_SIMILARITY=0.18
MEMORY_DECAY_RATE=0.02

# ---- The robot's X account ----------------------------------------
# OAuth 1.0a user context, from developer.x.com -> your app -> Keys and tokens.
# The app needs "Read and write" permission, and the access token must be
# REGENERATED after that permission is set or every post comes back 403.
# Leave these blank and the X tools are never registered — the robot behaves
# exactly as it did before.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# true = the robot drafts, reads it back, and waits for a spoken yes before
# anything becomes public. false = post_to_x publishes immediately.
X_REQUIRE_CONFIRM=true
# true = run the whole path but publish nothing. Starts ON deliberately: the
# first time you wire up an account you want to watch it work before anything
# it says is public. Set false when you are ready to post for real.
X_DRY_RUN=true
# Local guards, well under X's own quota. They bound a runaway loop.
X_MAX_POSTS_PER_HOUR=5
X_MAX_POSTS_PER_DAY=20

# ---- Autopilot (`--autopilot`) ------------------------------------
# Answering mentions with nobody in the room. There is no spoken yes on this
# path, so these caps are the only thing bounding a bad day. Reads are the
# metered half of the X API — polling harder buys 429s, not freshness.
X_AUTOPILOT_POLL_SECONDS=900
X_AUTOPILOT_MAX_REPLIES=3
X_AUTOPILOT_MENTION_LIMIT=10
# Which mentions have already been answered. Deleting this file makes the next
# run adopt the current backlog silently rather than answer it.
X_SEEN_PATH=minibot_seen.json

LOG_LEVEL=INFO
